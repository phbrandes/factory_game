class_name WorldMapRenderer
extends Node2D

## Renders 16x16 chunks of terrain and resource veins generated by WorldGenerator.
## Supports camera-bound chunk generation and visibility culling (ADR-017).

const WorldGeneratorRef = preload("res://src/core/world_generator.gd")
const VisualChunkRef = preload("res://src/visuals/chunking/visual_chunk.gd")
const VisualAssetRegistryRef = preload("res://src/visuals/visual_asset_registry.gd")

const CHUNK_SIZE: int = 16

var world_generator: RefCounted
var cell_size_pixels: float = 64.0
var _terrain_chunks: Dictionary = {} # Vector2i (ChunkCoord) : VisualChunk

func _init() -> void:
	z_index = -10

func setup(p_generator: RefCounted, p_cell_size: float = 64.0) -> void:
	world_generator = p_generator
	cell_size_pixels = p_cell_size

## Ensures a 16x16 terrain chunk is generated in WorldGenerator and instantiated visually.
func ensure_chunk_rendered(c_coord: Vector2i) -> VisualChunk:
	if _terrain_chunks.has(c_coord):
		return _terrain_chunks[c_coord]
		
	if world_generator != null:
		world_generator.ensure_chunk_generated(c_coord)
		
	var chunk_node := VisualChunkRef.new(c_coord)
	chunk_node.name = "TerrainChunk_%d_%d" % [c_coord.x, c_coord.y]
	add_child(chunk_node)
	_terrain_chunks[c_coord] = chunk_node
	
	_populate_chunk_sprites(chunk_node, c_coord)
	return chunk_node

## Generates any missing chunks in [bounds_min..bounds_max] and culls chunks outside the bounds.
func update_active_chunks(bounds_min: Vector2i, bounds_max: Vector2i) -> void:
	for cx in range(bounds_min.x, bounds_max.x + 1):
		for cy in range(bounds_min.y, bounds_max.y + 1):
			ensure_chunk_rendered(Vector2i(cx, cy))
			
	for c_coord in _terrain_chunks.keys():
		var chunk: VisualChunk = _terrain_chunks[c_coord]
		var is_active: bool = (
			c_coord.x >= bounds_min.x and c_coord.x <= bounds_max.x and
			c_coord.y >= bounds_min.y and c_coord.y <= bounds_max.y
		)
		chunk.set_active(is_active)

## Convenience helper that converts a world-space pixel Rect2 (e.g. Camera2D viewport) into chunk bounds.
func update_from_world_rect(world_rect: Rect2, padding_chunks: int = 1) -> void:
	var min_grid := Vector2i((world_rect.position / cell_size_pixels).floor())
	var max_grid := Vector2i((world_rect.end / cell_size_pixels).ceil())
	
	var min_chunk := Vector2i(
		int(floor(float(min_grid.x) / CHUNK_SIZE)) - padding_chunks,
		int(floor(float(min_grid.y) / CHUNK_SIZE)) - padding_chunks
	)
	var max_chunk := Vector2i(
		int(floor(float(max_grid.x) / CHUNK_SIZE)) + padding_chunks,
		int(floor(float(max_grid.y) / CHUNK_SIZE)) + padding_chunks
	)
	update_active_chunks(min_chunk, max_chunk)

func get_rendered_chunk_count() -> int:
	return _terrain_chunks.size()

func is_chunk_visible(c_coord: Vector2i) -> bool:
	if not _terrain_chunks.has(c_coord):
		return false
	return _terrain_chunks[c_coord].visible

func _populate_chunk_sprites(chunk_node: VisualChunk, c_coord: Vector2i) -> void:
	if world_generator == null:
		return
		
	var scale_factor := cell_size_pixels / float(VisualAssetRegistryRef.NATIVE_TILE_PIXELS)
	var ground_tex := VisualAssetRegistryRef.get_terrain_tile_texture("ground")
	var base_x := c_coord.x * CHUNK_SIZE
	var base_y := c_coord.y * CHUNK_SIZE
	
	for lx in range(CHUNK_SIZE):
		for ly in range(CHUNK_SIZE):
			var global_pos := Vector2i(base_x + lx, base_y + ly)
			var tile_data: Dictionary = world_generator.get_tile_data(global_pos)
			var terrain: String = String(tile_data.get("terrain", "ground"))
			var resource: String = String(tile_data.get("resource", ""))
			var pixel_pos := Vector2(global_pos) * cell_size_pixels
			
			# 1. Base ground tile
			var base_sprite := Sprite2D.new()
			if terrain == "water":
				base_sprite.texture = VisualAssetRegistryRef.get_terrain_tile_texture("water")
			else:
				base_sprite.texture = ground_tex
				# Subtle checkerboard shading for grid readability (03_ART_BIBLE.md Priority #1: Readability)
				if terrain == "grass":
					base_sprite.modulate = Color(0.84, 0.91, 0.80, 1.0)
				else:
					base_sprite.modulate = Color(0.88, 0.92, 0.85, 1.0)
			base_sprite.scale = Vector2.ONE * scale_factor
			base_sprite.position = pixel_pos
			chunk_node.add_child(base_sprite)
			
			# 2. Obstacle overlay (Rock / Tree)
			if terrain == "rock":
				var rock_sprite := Sprite2D.new()
				rock_sprite.texture = VisualAssetRegistryRef.get_terrain_tile_texture("rock")
				rock_sprite.scale = Vector2.ONE * scale_factor
				rock_sprite.position = pixel_pos
				rock_sprite.z_index = 1
				chunk_node.add_child(rock_sprite)
			elif terrain == "tree":
				var tree_sprite := Sprite2D.new()
				tree_sprite.texture = VisualAssetRegistryRef.get_terrain_tile_texture("tree")
				tree_sprite.scale = Vector2.ONE * (scale_factor * 0.5)
				tree_sprite.position = pixel_pos
				tree_sprite.z_index = 1
				chunk_node.add_child(tree_sprite)
				
			# 3. Resource vein overlay (iron_ore, copper_ore, coal, gold_ore)
			if resource != "":
				var res_sprite := Sprite2D.new()
				res_sprite.texture = VisualAssetRegistryRef.get_terrain_tile_texture(resource)
				res_sprite.scale = Vector2.ONE * scale_factor
				res_sprite.position = pixel_pos
				res_sprite.z_index = 1
				chunk_node.add_child(res_sprite)
